{
  "dataset_version": "insight-agent-v1-2026-09-08",
  "dataset_status": "frozen-before-model-run",
  "split": "dev",
  "database": "insight_agent",
  "knowledge_base": "汽车配件企业制度库",
  "synthetic_data_notice": "全部经营数据与制度均为确定性合成演示数据。",
  "policy": {
    "fresh_conversation_per_case": true,
    "preserve_raw_trajectory": true,
    "do_not_modify_gold_after_failure": true,
    "manual_review_requires_reason": true
  },
  "cases": [
    {
      "id": "v1-dev-sql-01", "type": "text_to_sql",
      "question": "2026 年第二季度哪个区域销售额环比下降最多？请给出区域和环比变化率。",
      "expected_facts": [{"name": "region", "value": "华东"}, {"name": "qoq_pct", "kind": "numeric", "value": -3.17, "accepted_values": [-0.0317], "tolerance": 0.02}],
      "numeric_tolerance": 0.01, "grading": "deterministic",
      "gold_sql": "WITH q AS (SELECT r.region_name, SUM(s.sales_amount) FILTER (WHERE s.sale_date >= DATE '2026-04-01' AND s.sale_date < DATE '2026-07-01') q2, SUM(s.sales_amount) FILTER (WHERE s.sale_date >= DATE '2026-01-01' AND s.sale_date < DATE '2026-04-01') q1 FROM fact_sales s JOIN dim_region r ON r.region_id=s.region_id GROUP BY r.region_name) SELECT region_name, ROUND((q2-q1)/NULLIF(q1,0)*100,2) qoq_pct FROM q ORDER BY qoq_pct LIMIT 1;"
    },
    {
      "id": "v1-dev-sql-02", "type": "text_to_sql",
      "question": "华东区域 2026 Q2 销售额是多少？环比和同比分别是多少？",
      "expected_facts": [{"name": "sales", "kind": "numeric", "value": 15228822.09, "tolerance": 0.02}, {"name": "qoq_pct", "kind": "numeric", "value": -3.17, "accepted_values": [-0.0317], "tolerance": 0.02}, {"name": "yoy_pct", "kind": "numeric", "value": 1.85, "accepted_values": [0.0185], "tolerance": 0.02}],
      "numeric_tolerance": 0.01, "grading": "deterministic",
      "gold_sql": "SELECT SUM(sales_amount) FILTER (WHERE sale_date>=DATE '2026-04-01' AND sale_date<DATE '2026-07-01') q2_sales FROM fact_sales s JOIN dim_region r ON r.region_id=s.region_id WHERE r.region_name='华东';"
    },
    {
      "id": "v1-dev-sql-03", "type": "text_to_sql",
      "question": "华东 2026 Q2 哪个汽车配件品类销售额环比下降最多？下降比例是多少？",
      "expected_facts": [{"name": "category", "value": "刹车系统"}, {"name": "qoq_pct", "kind": "numeric", "value": -32.68, "accepted_values": [-0.3268], "tolerance": 0.02}],
      "numeric_tolerance": 0.01, "grading": "deterministic",
      "gold_sql": "WITH q AS (SELECT p.category, SUM(s.sales_amount) FILTER (WHERE s.sale_date>=DATE '2026-04-01' AND s.sale_date<DATE '2026-07-01') q2, SUM(s.sales_amount) FILTER (WHERE s.sale_date>=DATE '2026-01-01' AND s.sale_date<DATE '2026-04-01') q1 FROM fact_sales s JOIN dim_region r ON r.region_id=s.region_id JOIN dim_product p ON p.product_id=s.product_id WHERE r.region_name='华东' GROUP BY p.category) SELECT category, ROUND((q2-q1)/NULLIF(q1,0)*100,2) FROM q ORDER BY 2 LIMIT 1;"
    },
    {
      "id": "v1-dev-sql-04", "type": "text_to_sql",
      "question": "比较华东与华南刹车系统 2026 Q2 的销售额环比变化率。",
      "expected_facts": [{"name": "east", "value": "华东"}, {"name": "east_qoq", "kind": "numeric", "value": -32.68, "accepted_values": [-0.3268], "tolerance": 0.02}, {"name": "south", "value": "华南"}, {"name": "south_qoq", "kind": "numeric", "value": 9.51, "accepted_values": [0.0951], "tolerance": 0.02}],
      "numeric_tolerance": 0.01, "grading": "deterministic",
      "gold_sql": "SELECT r.region_name, SUM(s.sales_amount) FILTER (WHERE s.sale_date>=DATE '2026-04-01' AND s.sale_date<DATE '2026-07-01') q2, SUM(s.sales_amount) FILTER (WHERE s.sale_date>=DATE '2026-01-01' AND s.sale_date<DATE '2026-04-01') q1 FROM fact_sales s JOIN dim_region r ON r.region_id=s.region_id JOIN dim_product p ON p.product_id=s.product_id WHERE r.region_name IN ('华东','华南') AND p.category='刹车系统' GROUP BY r.region_name;"
    },
    {
      "id": "v1-dev-sql-05", "type": "text_to_sql",
      "question": "华东刹车系统的加权毛利率从 2026 Q1 到 Q2 变化了多少个百分点？",
      "expected_facts": [{"name": "q1_margin_pct", "kind": "numeric", "value": 28.91, "accepted_values": [0.2891], "tolerance": 0.02}, {"name": "q2_margin_pct", "kind": "numeric", "value": 26.13, "accepted_values": [0.2613], "tolerance": 0.02}, {"name": "change_pp", "kind": "numeric", "value": -2.78, "tolerance": 0.02}],
      "numeric_tolerance": 0.01, "grading": "deterministic",
      "gold_sql": "SELECT SUM(gross_profit) FILTER (WHERE sale_date>=DATE '2026-04-01' AND sale_date<DATE '2026-07-01')/NULLIF(SUM(sales_amount) FILTER (WHERE sale_date>=DATE '2026-04-01' AND sale_date<DATE '2026-07-01'),0) q2_margin FROM fact_sales s JOIN dim_region r ON r.region_id=s.region_id JOIN dim_product p ON p.product_id=s.product_id WHERE r.region_name='华东' AND p.category='刹车系统';"
    },
